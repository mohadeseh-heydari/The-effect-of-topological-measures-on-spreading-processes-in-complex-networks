      "  PLc[12,13] = 2\n",
      "  PLc[12,14] = 0\n",
      "  PLc[12,15] = 2\n",
      "  PLc[12,17] = 0\n",
      "  PLc[12,19] = 2\n",
      "  PLc[12,20] = 2\n",
      "  PLc[12,21] = 2\n",
      "  PLc[12,23] = 2\n",
      "مخرج (n - |N[12]|) = 17\n",
      "\n",
      "PLc12 = 1.5294\n"
     ]
