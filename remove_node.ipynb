   "source": [
    "\"\"\"\n",
    "تصویرسازی اثر حذف یک گره‌ی دلخواه روی شبکه:\n",
    "\n",
    "پنل ۱: شبکه‌ی اصلی، با گره‌ی موردنظر (صورتی پررنگ)، همسایه‌های مستقیمش\n",
    "        N[v] (صورتی روشن)، و یال‌های واردشونده به آن (پررنگ).\n",
    "\n",
    "پنل ۲: شبکه پس از حذف گره، که هر گره‌ی باقی‌مانده بر اساس تغییر PLc_i\n",
    "        خودش (قبل منهای بعد از حذف) رنگ شده است:\n",
    "            آبی  => PLc_i آن گره بعد از حذف کاهش یافته (بهتر شده)\n",
    "            قرمز => PLc_i آن گره بعد از حذف افزایش یافته (بدتر شده)\n",
    "        این پنل نشان می‌دهد نبود گره‌ی حذف‌شده دقیقاً روی کدام گره‌ها و\n",
    "        چقدر اثر گذاشته است.\n",
    "\"\"\"\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# بارگذاری شبکه از فایل csv (ماتریس مجاورت)\n",
    "# ---------------------------------------------------------\n",
    "def load_graph(csv_path):\n",
    "    mat = pd.read_csv(csv_path, header=0).values\n",
    "    g = nx.from_numpy_array(mat)\n",
    "    return g\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# اجرای فرآیند انتشار آستانه‌ای (Cascade) از یک مجموعه فعال اولیه\n",
    "# ---------------------------------------------------------\n",
    "def run_cascade(g, initial_active, threshold):\n",
    "    active_set = set(initial_active)\n",
    "    while True:\n",
    "        new_nodes = []\n",
    "        for node in g.nodes():\n",
    "            if node in active_set:\n",
    "                continue\n",
    "            active_neighbors = sum(1 for nb in g.neighbors(node) if nb in active_set)\n",
    "            if active_neighbors >= threshold:\n",
    "                new_nodes.append(node)\n",
    "        if not new_nodes:\n",
    "            break\n",
    "        active_set.update(new_nodes)\n",
    "    return active_set\n",
    "\n",
    "\n",
    "# ---------------------------------------------------------\n",
    "# محاسبه‌ی قطعیِ PLc_i یک گره مشخص (seed = N[v])\n",
    "# ---------------------------------------------------------\n",
    "def compute_plci_deterministic(g, v, threshold):\n",
    "    n = g.number_of_nodes()\n",
    "    N_v = set(g.neighbors(v)) | {v}\n",
    "    cascade_nodes = run_cascade(g, N_v, threshold)\n",
    "    active_graph = g.subgraph(cascade_nodes)\n",
    "    target_nodes = [node for node in g.nodes() if node not in N_v]\n",
    "\n",
    "    path_lengths = []\n",
    "    for node in target_nodes:\n",
    "        if node in cascade_nodes:\n",
    "            length = nx.shortest_path_length(active_graph, source=v, target=node)\n",
    "        else:\n",
    "            length = 0\n",
    "        path_lengths.append(length)\n",
    "\n",
    "    denom = n - len(N_v)\n",
    "    return sum(path_lengths) / denom if denom > 0 else 0.0\n",
    "\n",
    "\n",
    "# ===========================================================\n",
    "#                        بخش اجرا\n",
    "#   (اینجا می‌تونی مسیر فایل، گره‌ی حذفی و آستانه رو عوض کنی)\n",
    "# ===========================================================\n",
    "if __name__ == \"__main__\":\n",
    "    CSV_PATH = \"/mnt/f/test/addhealth_net_75.csv\"\n",
    "    NODE_TO_REMOVE = 12\n",
    "    THRESHOLD = 4\n",
    "\n",
    "    g_before = load_graph(CSV_PATH)\n",
    "    pos = nx.spring_layout(g_before, seed=7, k=2.0, iterations=200)\n",
    "\n",
    "    v = NODE_TO_REMOVE\n",
    "    N_v = set(g_before.neighbors(v))\n",
    "\n",
    "    # -------------------------------------------------------\n",
    "    # محاسبه‌ی PLc_i هر گره، قبل و بعد از حذف\n",
    "    # -------------------------------------------------------\n",
    "    g_after = g_before.copy()\n",
    "    g_after.remove_node(v)\n",
    "\n",
    "    plci_before = {node: compute_plci_deterministic(g_before, node, THRESHOLD) for node in g_before.nodes() if node != v}\n",
    "    plci_after = {node: compute_plci_deterministic(g_after, node, THRESHOLD) for node in g_after.nodes()}\n",
    "\n",
    "    delta = {node: plci_after[node] - plci_before[node] for node in plci_after}\n",
    "    # delta > 0  => PLc_i کاهش یافته بعد از حذف (بهتر شده) -> آبی\n",
    "    # delta < 0  => PLc_i افزایش یافته بعد از حذف (بدتر شده) -> قرمز\n",
    "\n",
    "    print(\"تغییر PLc_i هر گره (قبل - بعد از حذف):\")\n",
    "    for node in sorted(delta):\n",
    "        print(f\" گره \\u200e{node:>2}: قبل=\\u200e{plci_before[node]:.4f}  بعد=\\u200e{plci_after[node]:.4f}  \" f\"تغییر=\\u200e{delta[node]:+.4f}\")\n",
    "\n",
    "    # -------------------------------------------------------\n",
    "    # رسم\n",
    "    # -------------------------------------------------------\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(20, 10))\n",
    "\n",
    "    # --- پنل ۱: شبکه‌ی اصلی با گره‌ی موردنظر برجسته ---\n",
    "    ax1 = axes[0]\n",
    "    node_colors_1 = []\n",
    "    for node in g_before.nodes():\n",
    "        if node == v:\n",
    "            node_colors_1.append(\"#FF1493\")        # صورتی پررنگ برای خود گره\n",
    "        elif node in N_v:\n",
    "            node_colors_1.append(\"#FFB6D9\")        # صورتی روشن برای همسایه‌ها\n",
    "        else:\n",
    "            node_colors_1.append(\"lightgray\")\n",
    "\n",
    "    edge_colors_1 = []\n",
    "    edge_widths_1 = []\n",
    "    for u, w in g_before.edges():\n",
    "        if u == v or w == v:\n",
    "            edge_colors_1.append(\"#FF1493\")\n",
    "            edge_widths_1.append(2.5)\n",
    "        else:\n",
    "            edge_colors_1.append(\"lightgray\")\n",
    "            edge_widths_1.append(0.8)\n",
    "\n",
    "    nx.draw_networkx_edges(g_before, pos, ax=ax1, edge_color=edge_colors_1, width=edge_widths_1, alpha=0.6)\n",
    "    nx.draw_networkx_nodes(g_before, pos, ax=ax1, node_color=node_colors_1, node_size=550)\n",
    "    nx.draw_networkx_labels(g_before, pos, ax=ax1, font_size=10)\n",
    "    ax1.set_title(f\"Original Network — Node {v} (dark pink) and its neighbors N[{v}] (light pink)\", fontsize=12)\n",
    "    ax1.axis(\"off\")\n",
    "\n",
    "    # --- پنل ۲: شبکه بعد از حذف، رنگ‌شده بر اساس تغییر PLc_i ---\n",
    "    ax2 = axes[1]\n",
    "    pos_after = {node: pos[node] for node in g_after.nodes()}\n",
    "\n",
    "    vmax = max(abs(x) for x in delta.values()) if delta else 1\n",
    "    norm = mcolors.TwoSlopeNorm(vmin=-vmax, vcenter=0, vmax=vmax)\n",
    "    cmap = matplotlib.colormaps.get_cmap(\"coolwarm_r\")  # آبی = بهتر شده، قرمز = بدتر شده\n",
    "    node_colors_2 = [cmap(norm(delta[node])) for node in g_after.nodes()]\n",
    "\n",
    "    nx.draw_networkx_edges(g_after, pos_after, ax=ax2, alpha=0.3)\n",
    "    nodes_drawn = nx.draw_networkx_nodes(g_after, pos_after, ax=ax2, node_color=node_colors_2, node_size=550)\n",
    "    nx.draw_networkx_labels(g_after, pos_after, ax=ax2, font_size=10)\n",
    "    ax2.set_title(f\"Network After Removing Node {v} — color = change in each node's PLc_i\", fontsize=12)\n",
    "    ax2.axis(\"off\")\n",
    "\n",
    "    sm = cm.ScalarMappable(cmap=cmap, norm=norm)\n",
    "    sm.set_array([])\n",
    "    cbar = fig.colorbar(sm, ax=ax2, fraction=0.046, pad=0.04)\n",
    "    cbar.set_label(\"PLc_i after minus PLc_i before removal\\n(blue = improved, red = worsened)\", fontsize=10)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\"/mnt/d/study/term8/پروژه/fig.png\")\n",
    "    plt.show()"
   ]
  }
