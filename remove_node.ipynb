    "    CSV_PATH = \"/mnt/f/test/addhealth_net_75.csv\"\n",
    "    NODE_TO_REMOVE = 12\n",
    "    THRESHOLD = 4\n",
    "\n",
    "    compare_before_after_removal(CSV_PATH, NODE_TO_REMOVE, THRESHOLD)"
