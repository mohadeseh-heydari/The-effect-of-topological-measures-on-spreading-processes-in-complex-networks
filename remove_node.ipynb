   "source": [
    "# بارگذاری شبکه از فایل csv (ماتریس مجاورت)\n",
    "def load_graph(csv_path):\n",
    "    mat = pd.read_csv(csv_path, header=0).values\n",
    "    g = nx.from_numpy_array(mat)\n",
    "    return g\n",
    "\n",
    "# اجرای فرآیند انتشار آستانه‌ای (Cascade) از یک مجموعه فعال اولیه\n",
    "def run_cascade(g, initial_active, threshold):\n",
    "    active_set = set(initial_active)\n",
    "\n",
    "    while True:\n",
    "        new_nodes = []\n",
    "        for node in g.nodes():\n",
    "            if node in active_set:\n",
    "                continue\n",
    "            active_neighbors = sum(1 for nb in g.neighbors(node) if nb in active_set)\n",
    "            if active_neighbors >= threshold:\n",
    "                new_nodes.append(node)\n",
    "\n",
    "        if not new_nodes:\n",
    "            break\n",
    "\n",
    "        active_set.update(new_nodes)\n",
    "\n",
    "    return active_set\n",
    "\n",
    "# محاسبه‌ی قطعیِ PLc_i یک گره مشخص (بدون رندوم، بدون تکرار)\n",
    "def compute_plci_deterministic(g, v, threshold, verbose=False):\n",
    "    n = g.number_of_nodes()\n",
    "    N_v = set(g.neighbors(v)) | {v}   # همسایگی بسته‌ی v = seed اولیه\n",
    "\n",
    "    cascade_nodes = run_cascade(g, N_v, threshold)\n",
    "    active_graph = g.subgraph(cascade_nodes)\n",
    "\n",
    "    target_nodes = [node for node in g.nodes() if node not in N_v]\n",
    "\n",
    "    path_lengths = {}\n",
    "    for node in target_nodes:\n",
    "        if node in cascade_nodes:\n",
    "            length = nx.shortest_path_length(active_graph, source=v, target=node)\n",
    "        else:\n",
    "            length = 0\n",
    "        path_lengths[node] = length\n",
    "\n",
    "    denom = n - len(N_v)\n",
    "    plci = sum(path_lengths.values()) / denom if denom > 0 else 0.0\n",
    "\n",
    "    if verbose:\n",
    "        print(f\"N[{v}] (seed اولیه) = {sorted(N_v)}\")\n",
    "        print(f\"\nگره‌های فعال‌شده طی فرایند: {sorted(cascade_nodes)}\")\n",
    "        print(f"\nگره‌های هدف: {sorted(target_nodes)}"),
    "        print("\nطول مسیر پیچیده تا هر گره‌ی هدف:"),
    "        for node in sorted(target_nodes):\n",
    "            print(f\"  PLc[{v},{node}] = {path_lengths[node]}\")\n",
    "        print(f\"مخرج (n - |N[{v}]|) = {denom}\")\n",
    "\n",
    "    return plci\n",
    "\n",
    "# بخش اجرا\n",
    "if __name__ == \"__main__\":\n",
    "    CSV_PATH = \"/mnt/f/test/addhealth_net_75.csv\"\n",
    "    NODE = 12   # گرۀ دلخواه\n",
    "    THRESHOLD = 4   #آستانه\n",
    "\n",
    "    g = load_graph(CSV_PATH)\n",
    "\n",
    "    print(f\"===== محاسبه‌ی قطعیِ PLc برای گره {NODE} (Threshold = {THRESHOLD}) =====\\n\")\n",
    "    plci = compute_plci_deterministic(g, NODE, THRESHOLD, verbose=True)\n",
    "    print(f\"\\nPLc{NODE} = {plci:.4f}\")"
   ]
  },
