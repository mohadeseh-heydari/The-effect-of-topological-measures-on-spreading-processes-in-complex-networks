    "    print(\"-\" * 50)\n",
    "    print(f\"PLc قبل از حذف گره {node_to_remove} = {plc_before:.4f}\")\n",
    "    print(f\"PLc بعد از حذف گره {node_to_remove} = {plc_after:.4f}\")\n",
    "    print(f\"تفاوت (بعد - قبل) = {diff:+.4f}\")\n",
    "\n",
    "    if diff > 0:\n",
    "        print(f\"\\n=> حذف گره {node_to_remove} باعث افزایش PLc کل شبکه شده است.\")\n",
    "    elif diff < 0:\n",
    "        print(f\"\\n=> حذف گره {node_to_remove} باعث کاهش PLc کل شبکه شده است.\")\n",
    "    else:\n",
    "        print(f\"\\n=> حذف گره {node_to_remove} تأثیری روی PLc کل شبکه نداشته است.\")\n",
    "\n",
    "    return plc_before, plc_after\n",
    "\n",
    "# بخش اجرا\n",
