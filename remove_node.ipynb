      "طول مسیر مختلط تا هر گره‌ی هدف:\n",
      "  PLc[12,0] = 2\n",
      "  PLc[12,1] = 0\n",
      "  PLc[12,2] = 2\n",
      "  PLc[12,4] = 2\n",
